# Root-level env vars consumed by docker-compose.{dev,prod}.yml
# Copy this file to .env and fill in real values. Do NOT commit .env.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=ai_garden_db

# prod only: values substituted into ReactFrontend/nginx.prod.conf
FRONTEND_ORIGIN=https://your-domain.example.com
MODEL_SUTURE_URL=http://model-server-host:4000
