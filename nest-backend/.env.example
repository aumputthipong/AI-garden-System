POSTGRES_HOST=localhost
# db or localhost or host.docker.internal
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DATABASE=ai_garden_db
DATABASE_URL=postgres://postgres:change-me@localhost:5432/ai_garden_db

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_SECRET=your-google-client-secret

JWT_SECRET=change-me
INVITE_SECRET=change-me
SESSION_SECRET=change-me
NODE_ENV=development

# อีเมลที่ได้สิทธิ์ admin และ promote/demote admin ได้ (คั่นด้วย comma)
ADMIN_EMAILS=admin1@example.com,admin2@example.com
